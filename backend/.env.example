# Copy to .env and set strong production secrets.
DATABASE_URL=sqlite:///./store.db
AUTH_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=10080
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CURRENCY=egp
PAYMENT_PROVIDER=paymob
PUBLIC_API_URL=https://your-public-api.example.com
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_PAYMENT_METHODS=

# Optional Stripe credentials when PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SMTP provider settings for welcome, payment and cart reminder emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=NOVA Home + Tech
SMTP_USE_TLS=true

ENABLE_CART_REMINDERS=true
CART_REMINDER_AFTER_HOURS=4
CART_REMINDER_REPEAT_HOURS=24
